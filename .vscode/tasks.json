{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Backend",
      "type": "shell",
      "command": "mvn clean package -f backend/pom.xml -DskipTests",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$maven"]
    },
    {
      "label": "Run Backend Tests",
      "type": "shell",
      "command": "mvn test -f backend/pom.xml",
      "group": "test",
      "problemMatcher": ["$maven"]
    },
    {
      "label": "Run Selenium UI Test",
      "type": "shell",
      "command": "mvn test -f backend/pom.xml -Dtest=LoginTest -DfailIfNoTests=false",
      "group": "test",
      "problemMatcher": ["$maven"]
    },
    {
      "label": "Run DevClimb (Cargo)",
      "type": "shell",
      "command": "mvn clean package cargo:run -f backend/pom.xml",
      "group": "none",
      "problemMatcher": ["$maven"]
    }
  ]
}